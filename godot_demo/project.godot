; Engine configuration file.
; Standalone Godot project for the classic "prologue + life pool" demo.

config_version=5

[application]

config/name="gamelife demo"
config/description="序章 + 人生池 · 传说之下式像素剧情 Demo"
run/main_scene="res://scenes/DemoTrial.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=520
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

{
  "version": 2,
  "title": "剧情过场时间轴",
  "description": "按事件 id 匹配的 Undertale 式过场：bg 与人物使用 SL 库最新的 pixel_cast 图集（每角色 4 帧：静止/走/说话抬手）；beat 的 action 语义映射到 walk / 抬手 / 静止，expr 作为立绘提示；beats 是逐字对白，选项取自事件本身。",
  "cutscenes": {
    "OP01": {
      "bg": "hospital",
      "cast": [
        {"role": "parent", "x": 118, "y": 74, "action": "idle", "face": "normal"},
        {"role": "lead", "x": 52, "y": 76, "action": "idle", "face": "normal"}
      ],
      "beats": [
        {"speaker": "旁白", "face": "lead", "expr": "normal", "text": "凌晨四点，雨刚停。产房的灯管嗡嗡响，你被一双戴橡胶手套的手倒提着，拍了两下脚心。"},
        {"speaker": "你", "face": "lead", "expr": "surprise", "text": "……"},
        {"speaker": "妈妈", "face": "parent", "expr": "normal", "action": "wave", "target": "parent", "text": "看，是个健康的宝宝。"}
      ]
    },
    "V03": {
      "bg": "park",
      "cast": [
        {"role": "lead", "x": 60, "y": 74, "action": "idle", "face": "normal"},
        {"role": "friend", "x": 118, "y": 74, "from": [152, 74], "walk_time": 1.1, "action": "idle", "face": "normal"}
      ],
      "beats": [
        {"speaker": "旁白", "face": "lead", "expr": "normal", "text": "手机响了三次，一个陌生号码。"},
        {"speaker": "你", "face": "lead", "expr": "surprise", "text": "喂？"},
        {"speaker": "老同学", "face": "friend", "expr": "normal", "action": "wave", "target": "friend", "text": "是我。……我回来了，想见一面。"},
        {"speaker": "你", "face": "lead", "expr": "happy", "action": "idle", "target": "friend", "text": "你这些年，到底去哪儿了？"}
      ]
    },
    "V13": {
      "bg": "hospital",
      "cast": [
        {"role": "lead", "x": 60, "y": 76, "action": "idle", "face": "normal"},
        {"role": "parent", "x": 118, "y": 74, "action": "idle", "face": "normal"}
      ],
      "beats": [
        {"speaker": "旁白", "face": "lead", "expr": "blink", "text": "凌晨两点，医院的走廊很亮，亮得人睡不着。"},
        {"speaker": "爸爸", "face": "parent", "expr": "normal", "action": "raise", "target": "parent", "text": "没事，你回去睡吧。"},
        {"speaker": "你", "face": "lead", "expr": "sad", "action": "idle", "target": "parent", "text": "爸，你先回去吧，今晚我守着。"}
      ]
    }
  }
}
